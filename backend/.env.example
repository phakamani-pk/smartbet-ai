# Database
DATABASE_URL=postgresql://smartbet_user:smartbet_password@localhost:5432/smartbet_ai_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# API
API_TITLE=SmartBet AI API
API_VERSION=1.0.0
API_DESCRIPTION=AI-powered betting and lottery analytics platform
DEBUG=True

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO

# ML Models
ML_MODELS_PATH=ml_models/

# Subscription
SUBSCRIPTION_KEY_SECRET=your-subscription-key-secret

# External APIs (for sports data, lottery results, etc.)
SPORTS_API_KEY=your-sports-data-api-key
LOTTERY_API_KEY=your-lottery-data-api-key
